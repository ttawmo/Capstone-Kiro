# Copy to .env.local and fill in to use a real Supabase project.
# If these are left blank, the app uses a local in-memory data store so it still
# runs end-to-end without any backend (useful for the demo and for offline work).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Blockchain (local Hardhat node). Defaults match the first-deploy address.
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
