# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Blockchain (local Hardhat network) ---
# RPC URL of the local Ethereum node (Hardhat default)
RPC_URL=http://127.0.0.1:8545
# Address of the deployed contract (filled in after deploy)
CONTRACT_ADDRESS=
# Deployer / role private keys come from the local Hardhat node accounts.
# Do NOT put real-network private keys here.

# --- Supabase (off-chain data + document storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key is backend-only; never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (Vite) ---
# Vite only exposes vars prefixed with VITE_ to the browser.
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CONTRACT_ADDRESS=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
